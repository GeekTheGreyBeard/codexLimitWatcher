{
  "name": "codex-limit-watcher",
  "version": "0.1.0",
  "description": "Standalone Linux desktop watcher for Codex 5-hour and weekly usage limit resets.",
  "main": "src/main.js",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:wayland": "electron . --ozone-platform=wayland --enable-features=WaylandWindowDecorations --disable-features=Vulkan --disable-gpu",
    "status": "node src/usageReader.js",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^42.3.3"
  }
}
